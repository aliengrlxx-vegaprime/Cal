export interface PillarDef {   key: string;   name: string;   d: number; // validated drop-off multiplier }  export const PILLARS: PillarDef[] = [   { key: "clarity",              name: "Clarity",              d: 0.23 },   { key: "friction",             name: "Friction",             d: 0.38 },   { key: "ux_heuristics",        name: "UX Heuristics",        d: 0.12 },   { key: "messaging",            name: "Messaging",            d: 0.18 },   { key: "funnel_architecture",  name: "Funnel Architecture",  d: 0.27 },   { key: "offer_structure",      name: "Offer Structure",      d: 0.32 },   { key: "analytics_readiness",  name: "Analytics Readiness",  d: 0.15 },   { key: "conversion_readiness", name: "Conversion Readiness", d: 0.20 }, ];  export interface PillarState {   b: number; // 0 or 1 — current failure toggle   d: number; // validated drop-off multiplier (constant per pillar) }  export interface AGXXInputs {   T0: number;       // monthly traffic   CR0: number;      // current conversion rate (decimal)   AOV: number;   pillars: PillarState[];   p: number;        // confidence factor (0.4 – 0.7)   F: number;        // engagement fee }  export interface LossModelOutput {   SF0: number;                  // survival factor (0–1)   i: number;                    // surviving visitors (T0 × SF0)   C_current: number;   C_potential: number;   C_recoverable: number;   R_recoverable: number;       // monthly recoverable revenue   R_recoverable_annual: number; }  export interface PredictionOutput {   SF_future: number;           // assumed 1 (failing pillars fixed)   CR_future: number;   R_monthly_current: number;   R_monthly_future: number;   DeltaR_monthly: number;   DeltaR_monthly_expected: number; // confidence-weighted   DeltaR_annual_expected: number;   CostOfInaction_monthly: number;  // = DeltaR_monthly_expected   CostOfInaction_annual: number;   ROI_multiple: number;        // (annual expected gain) / Fee   ROI_percent: number;   Payback_months: number;      // Fee / monthly expected gain }  export function computeLossModel(inputs: AGXXInputs): LossModelOutput {   let SF0 = 1;   for (const p of inputs.pillars) {     SF0 *= 1 - p.b * p.d;   }   const i = inputs.T0 * SF0;   const C_current = inputs.T0 * inputs.CR0;   const C_potential = SF0 > 0 ? (inputs.T0 * inputs.CR0) / SF0 : 0;   const C_recoverable = C_potential - C_current;   const R_recoverable = C_recoverable * inputs.AOV;   return {     SF0,     i,     C_current,     C_potential,     C_recoverable,     R_recoverable,     R_recoverable_annual: R_recoverable * 12,   }; }  export function computePrediction(   inputs: AGXXInputs,   loss: LossModelOutput, ): PredictionOutput {   // Assume failing pillars are remediated → SF_future = 1.   const SF_future = 1;   const CR_future = loss.SF0 > 0 ? inputs.CR0 * (SF_future / loss.SF0) : inputs.CR0;   const R_monthly_current = loss.C_current * inputs.AOV;   const R_monthly_future = inputs.T0 * CR_future * inputs.AOV;   const DeltaR_monthly = R_monthly_future - R_monthly_current;   const DeltaR_monthly_expected = DeltaR_monthly * inputs.p;   const DeltaR_annual_expected = DeltaR_monthly_expected * 12;   const ROI_multiple = inputs.F > 0 ? DeltaR_annual_expected / inputs.F : 0;   const ROI_percent = inputs.F > 0 ? ((DeltaR_annual_expected - inputs.F) / inputs.F) * 100 : 0;   const Payback_months = DeltaR_monthly_expected > 0 ? inputs.F / DeltaR_monthly_expected : Infinity;   return {     SF_future,     CR_future,     R_monthly_current,     R_monthly_future,     DeltaR_monthly,     DeltaR_monthly_expected,     DeltaR_annual_expected,     CostOfInaction_monthly: DeltaR_monthly_expected,     CostOfInaction_annual: DeltaR_annual_expected,     ROI_multiple,     ROI_percent,     Payback_months,   }; }  export const LOG_KEY = "agxx_runs";  export interface LoggedRun {   timestamp: string;   note?: string;   inputs: AGXXInputs;   loss: LossModelOutput;   prediction: PredictionOutput; }  export function readRuns(): LoggedRun[] {   if (typeof window === "undefined") return [];   try {     const raw = localStorage.getItem(LOG_KEY);     return raw ? (JSON.parse(raw) as LoggedRun[]) : [];   } catch {     return [];   } }  export function logRun(run: LoggedRun) {   if (typeof window === "undefined") return;   const runs = readRuns();   runs.push(run);   localStorage.setItem(LOG_KEY, JSON.stringify(runs)); }  export function clearRuns() {   if (typeof window === "undefined") return;   localStorage.removeItem(LOG_KEY); }  export const fmtCurrency = (n: number) =>   Number.isFinite(n)     ? n.toLocaleString(undefined, { style: "currency", currency: "USD", maximumFractionDigits: 0 })     : "—"; export const fmtPct = (n: number, digits = 2) =>   Number.isFinite(n) ? `${(n * 100).toFixed(digits)}%` : "—"; export const fmtPctRaw = (n: number, digits = 2) =>   Number.isFinite(n) ? `${n.toFixed(digits)}%` : "—"; export const fmtNum = (n: number, digits = 2) =>   Number.isFinite(n) ? n.toLocaleString(undefined, { maximumFractionDigits: digits }) : "—"; export const fmtInt = (n: number) =>   Number.isFinite(n) ? Math.round(n).toLocaleString() : "—";